{
  "mode": "interactive",
  "granularity": "standard",
  "runtime": "codex",
  "model_profile": "balanced",
  "model_overrides": {
    "gsd-planner": "gpt-5.6-sol",
    "gsd-debugger": "gpt-6-astra",
    "gsd-roadmapper": "gpt-5.6-sol",
    "gsd-security-auditor": "gpt-5.6-sol",
    "gsd-code-reviewer": "gpt-5.6-sol",
    "gsd-executor": "gpt-5.6-terra",
    "gsd-plan-checker": "gpt-5.6-terra",
    "gsd-verifier": "gpt-5.6-terra",
    "gsd-phase-researcher": "gpt-5.6-luna",
    "gsd-project-researcher": "gpt-5.6-luna",
    "gsd-research-synthesizer": "gpt-5.6-luna",
    "gsd-pattern-mapper": "gpt-5.6-luna",
    "gsd-codebase-mapper": "gpt-5.6-luna",
    "gsd-doc-writer": "gpt-5.6-luna"
  },
  "effort": {
    "default": "medium",
    "routing_tier_defaults": {
      "light": "low",
      "standard": "medium",
      "heavy": "high"
    },
    "agent_overrides": {
      "gsd-planner": "high",
      "gsd-debugger": "medium",
      "gsd-roadmapper": "medium",
      "gsd-security-auditor": "medium",
      "gsd-code-reviewer": "medium",
      "gsd-executor": "medium",
      "gsd-plan-checker": "medium",
      "gsd-verifier": "medium",
      "gsd-phase-researcher": "low",
      "gsd-project-researcher": "low",
      "gsd-research-synthesizer": "low",
      "gsd-pattern-mapper": "low",
      "gsd-codebase-mapper": "low",
      "gsd-doc-writer": "low"
    }
  },
  "commit_docs": true,
  "parallelization": false,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "git": {
    "branching_strategy": "none",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": false,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": false,
    "auto_advance": false,
    "node_repair": false,
    "node_repair_budget": 1,
    "ui_phase": false,
    "ui_safety_gate": false,
    "ai_integration_phase": false,
    "api_coverage_gate": false,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": false,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": false,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": false,
    "security_enforcement": false,
    "security_asvs_level": 1,
    "security_block_on": "high"
  },
  "ship": {
    "pr_body_sections": []
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./.claude/CLAUDE.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "resolve_model_ids": "omit",
  "response_language": "Simplified Chinese"
}
